.ENABLE QUIET
.ENABLE SUBSTITUTION
SET DEF DB0:[203,1]
SET /BUF=TI:255
SET /TTSYNC=TI:
.SETS DEFPG "100"
.SETS PAGE "100"
.SETN NUM 100.
.TESTFILE S100.DAT
.IF <FILERR> = 1 .GOTO TOP
.DISABLE QUIET
FTP @DB0:[203,1]TTXSIX.FTP
.ENABLE QUIET
.TOP:
.TESTFILE S'PAGE'.DAT
.IF <FILERR> = 1 .GOTO FOUND
TYPE SNF.DAT
.GOTO PRMPT
.FOUND:
TYPE S'PAGE'.DAT
.PRMPT:
.OPENR TI:
.READ PAGE
.CLOSE
.IFT <EOF> .GOTO DONE
.IF PAGE = "" .GOTO INDEX
.IF PAGE = "Q" .GOTO DONE
.IF PAGE = "q" .GOTO DONE
.IF PAGE = "N" .GOTO NEXT
.IF PAGE = "n" .GOTO NEXT
.IF PAGE = "P" .GOTO PREV
.IF PAGE = "p" .GOTO PREV
.IF PAGE = "I" .GOTO INDEX
.IF PAGE = "i" .GOTO INDEX
.IF PAGE = "R" .GOTO FETCH
.IF PAGE = "r" .GOTO FETCH
.TEST PAGE
.IFF <NUMBER> .GOTO INDEX
.IF <STRLEN> GT 3. .GOTO INDEX
.SETN NUM 'PAGE'
.GOTO TOP
.NEXT:
.SETN NUM NUM+1
.SETS PAGE "'NUM'"
.GOTO TOP
.PREV:
.SETN NUM NUM-1
.SETS PAGE "'NUM'"
.GOTO TOP
.INDEX:
.SETS PAGE DEFPG
.SETN NUM 100.
.GOTO TOP
.FETCH:
.DISABLE QUIET
FTP @DB0:[203,1]TTXSIX.FTP
.ENABLE QUIET
.GOTO INDEX
.DONE:
.DISABLE QUIET
